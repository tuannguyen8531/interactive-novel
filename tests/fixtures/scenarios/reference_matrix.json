      "execution": "cloud",
      "provider": "gemini",
      "model": "to_be_filled",
      "hardware_profile": "client_cpu_only",
      "network_region": "to_be_filled",
      "privacy_mode": "explicit_cloud_opt_in",
      "status": "baseline_pending_phase_3"
    },
    {
      "id": "openrouter-cloud-default",
      "execution": "cloud",
      "provider": "openrouter",
      "model": "to_be_filled",
      "hardware_profile": "client_cpu_only",
      "network_region": "to_be_filled",
      "privacy_mode": "explicit_cloud_opt_in",
      "status": "baseline_pending_phase_3"
    }
  ],
  "record_for_each_run": [
    "hardware_profile",
    "provider",
    "model_and_version",
    "dataset_version",
    "prompt_version_and_hash",
    "config_snapshot_id",
    "mode",
    "context_size",
    "network_region",
