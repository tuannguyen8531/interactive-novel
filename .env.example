# Server
API_HOST=127.0.0.1
API_PORT=8000
API_LOG_LEVEL=info
LOG_RETENTION_DAYS=30
CORS_ORIGINS=http://localhost:5173
RUNTIME_DIR=runtime

# Default local targets used when runtime/settings.json does not exist yet.
# Provider/model routing can be edited later in Settings / Providers.
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# Cloud secrets. Keep values only in .env; runtime/settings.json stores the
# variable names, never the secret values.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
