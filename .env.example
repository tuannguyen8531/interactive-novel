# Server
API_HOST=127.0.0.1
API_PORT=8000
API_LOG_LEVEL=info
LOG_RETENTION_DAYS=30
CORS_ORIGINS=http://localhost:5173
INTERACTIVE_NOVEL_DEBUG=false
RUNTIME_DIR=runtime

# Provider settings used to seed runtime/settings.json on the first launch.
# After that, edit routing in Settings / Providers or remove settings.json to
# seed it from .env again. Secrets always remain in .env.
LLM_PROVIDER=ollama
FALLBACK_PROVIDER=
STORY_LANGUAGE=en
EXECUTION_MODE=quality
ALLOW_CLOUD_ROUTING=false
OLLAMA_BASE_URL=http://localhost:11434/api
OLLAMA_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_MODEL=qwen/qwen3-8b

# Cloud secrets. runtime/settings.json stores only the variable names.
GEMINI_API_KEY=
OPENROUTER_API_KEY=
